{
  "id": "netatmo",
  "version": "1.0.0",
  "name": {"en": "Netatmo · Legrand (cloud)", "es": "Netatmo · Legrand (cloud)", "fr": "Netatmo · Legrand (cloud)"},
  "roles": ["account", "driver"],
  "requires": {"api": "^1.0"},
  "provides": {"traits": ["cover.position@1.0", "light@1.0", "switch.relay@1.0", "energy.power@1.0"]},
  "models": ["Legrand Home + Control", "Legrand Ecocompteur"],
  "pairing": "oauth",
  "permissions": {"network": {"lan": false, "hosts": ["api.netatmo.com"]}},
  "read_every_s": 60,
  "cloud": true,
  "optional_calls": ["diagnostic"]
}

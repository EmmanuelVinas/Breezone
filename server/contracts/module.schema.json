{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breezone.app/contracts/module.schema.json",
  "title": "Manifest of a Breezone module",
  "description": "manifest.json of a module (docs/roadmap/modules.md § 4.3). The server reads it without loading the module's code. `src/modules/manifest.rs` checks the same rules, and more (an extension trait is named after its module, a driver provides traits…).",
  "type": "object",
  "required": ["id", "version", "name", "roles", "requires"],
  "additionalProperties": false,
  "$defs": {
    "label": {
      "type": "object",
      "required": ["fr", "en", "es"],
      "additionalProperties": false,
      "properties": { "fr": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 } }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "needed": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*@[1-9][0-9]*(\\.[0-9]+)?$" },
    "mdns": { "type": "string", "pattern": "^_.+\\._(tcp|udp)$" }
  },
  "properties": {
    "id": { "$ref": "#/$defs/id", "description": "Unique; the `driver` of its sources and the `kind` of its account." },
    "version": { "type": "string", "description": "Semantic version of the module (x.y.z)." },
    "name": { "$ref": "#/$defs/label" },
    "description": { "$ref": "#/$defs/label" },
    "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["driver", "account", "service"] } },
    "requires": {
      "type": "object",
      "required": ["api"],
      "additionalProperties": false,
      "properties": {
        "api": { "type": "string", "description": "Requirement on the module interface (`^1.0`)." },
        "breezone": { "type": "string", "description": "Requirement on the version of Breezone (`>=0.14.0, <2.0.0`); a pre-release counts as its version." },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traits": { "type": "array", "items": { "$ref": "#/$defs/needed" }, "description": "trait@major.revision, the lowest revision used." },
        "services": { "type": "array", "items": { "$ref": "#/$defs/needed" } }
      }
    },
    "models": { "type": "array", "items": { "type": "string" } },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "label"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["string", "integer", "number", "bool", "password"] },
          "optional": { "type": "boolean" },
          "label": { "$ref": "#/$defs/label" }
        }
      }
    },
    "config_version": { "type": "integer", "minimum": 1 },
    "fills": { "type": "object", "description": "Configuration values Breezone gives itself, by key: home.latitude and home.longitude when left empty, server.timezone always.", "additionalProperties": { "enum": ["home.latitude", "home.longitude", "server.timezone"] } },
    "pairing": { "enum": ["form", "button", "code", "oauth"] },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mdns": { "type": "array", "items": { "type": "object", "required": ["service"], "additionalProperties": false, "properties": { "service": { "$ref": "#/$defs/mdns" }, "txt": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "http": { "type": "array", "items": { "type": "object", "required": ["port", "path"], "additionalProperties": false, "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "path": { "type": "string", "pattern": "^/" }, "json_has": { "type": "array", "items": { "type": "string" } }, "contains": { "type": "string" } } } },
        "tcp": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "mac_oui": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){2}$" } }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lan": { "type": "boolean" },
            "hosts": { "type": "array", "description": "Hosts of the Internet it may reach: a name, or *.example.com for its subdomains.", "items": { "type": "string" } },
            "udp_broadcast": { "type": "boolean" },
            "mdns": { "type": "array", "items": { "$ref": "#/$defs/mdns" } }
          }
        },
        "memory_mb": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "read_every_s": { "type": "integer", "minimum": 0 },
    "cloud": { "type": "boolean" },
    "oauth": { "type": ["object", "null"], "description": "Its account is an OAuth 2 one (null: it is not): Breezone renews its access with the refresh token of its form.", "required": ["token_url"], "additionalProperties": false, "properties": { "token_url": { "type": "string", "pattern": "^https://" } } },
    "optional_calls": { "type": "array", "items": { "enum": ["rooms", "scenes", "picture", "forecast", "listen", "unlock", "diagnostic", "probe", "schedules", "forget", "identify"] } }
  }
}

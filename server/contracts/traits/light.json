    { "name": "color_temp_min", "type": "integer", "unit": "K", "optional": true, "label": { "fr": "Blanc le plus chaud", "en": "Warmest white", "es": "Blanco más cálido" } },
    { "name": "color_temp_max", "type": "integer", "unit": "K", "optional": true, "label": { "fr": "Blanc le plus froid", "en": "Coolest white", "es": "Blanco más frío" } },
    { "name": "color", "type": "string", "optional": true, "label": { "fr": "Couleur", "en": "Color", "es": "Color" } },
    { "name": "mode", "type": "enum", "values": ["white", "color"], "optional": true, "label": { "fr": "Mode", "en": "Mode", "es": "Modo" } },

{
  "trait": "cover.position",
  "version": 1,
  "label": { "fr": "Volet, store ou fenêtre", "en": "Shutter, blind or window", "es": "Persiana, toldo o ventana" },
  "state": [
    { "name": "position", "type": "integer", "unit": "%", "min": 0, "max": 100, "label": { "fr": "Ouverture", "en": "Opening", "es": "Apertura" } },
    { "name": "target", "type": "integer", "history": false, "unit": "%", "min": 0, "max": 100, "optional": true, "label": { "fr": "Ouverture demandée", "en": "Opening asked", "es": "Apertura pedida" } },
    { "name": "moving", "type": "enum", "values": ["opening", "closing", "stopped"], "value_labels": { "opening": { "fr": "S'ouvre", "en": "Opening", "es": "Abriéndose" }, "closing": { "fr": "Se ferme", "en": "Closing", "es": "Cerrándose" }, "stopped": { "fr": "Arrêté", "en": "Stopped", "es": "Detenido" } }, "optional": true, "label": { "fr": "Mouvement", "en": "Moving", "es": "Movimiento" } },
    { "name": "stoppable", "type": "bool", "history": false, "optional": true, "label": { "fr": "Peut être arrêté en cours de route", "en": "Can be stopped on the way", "es": "Puede detenerse a mitad de recorrido" } }
  ],
  "actions": [
    {
      "name": "set",
      "label": { "fr": "Ouvrir à", "en": "Open to", "es": "Abrir a" },
      "params": [
        { "name": "position", "type": "integer", "unit": "%", "min": 0, "max": 100, "label": { "fr": "Ouverture", "en": "Opening", "es": "Apertura" } }
      ]
    },
    {
      "name": "stop",
      "label": { "fr": "Arrêter", "en": "Stop", "es": "Detener" },
      "params": []
    }
  ]
}

# Breezone — local configuration.
# Copy to `.env` (scripts/run-local.sh does it for you) and adapt. `.env` is never committed.

# ── Web / API ─────────────────────────────────────────────────────────────────────────────
# Port published on the host (web UI + API + WebSocket).
BREEZONE_HTTP_PORT=8427
# Timezone used by the programmations (routines).
TZ=Europe/Paris
# Log level (error, warn, info, debug).
RUST_LOG=info,tower_http=warn,sqlx=warn

# ── Airzone ───────────────────────────────────────────────────────────────────────────────
# Local network of the server, scanned to find the Airzone WebServers (port 3000), e.g.
# 192.168.1.0/24. Also settable from the web UI (Réglages › Installations). Inside a container
# with the default bridge network, the server cannot guess it.
#BREEZONE_SCAN_SUBNET=192.168.1.0/24
# Optional: declare installations at first start ("Name=ip[:port]", comma separated).
# Otherwise, add them from the web UI (scan or Airzone account import).
#BREEZONE_AIRZONE_HOSTS=Maison=192.168.1.25
# Polling period of the WebServers, in seconds.
BREEZONE_POLL_INTERVAL_SECS=15

# ── History ───────────────────────────────────────────────────────────────────────────────
BREEZONE_HISTORY_INTERVAL_SECS=300
BREEZONE_HISTORY_RETENTION_DAYS=90
BREEZONE_EVENTS_RETENTION_DAYS=30
# Updates installed from the web UI (Settings › Breezone), from the official repository only.
#BREEZONE_SELF_UPDATE=false

# ── Accounts ──────────────────────────────────────────────────────────────────────────────
# Optional: create the administrator at first start instead of using the web setup page.
#BREEZONE_ADMIN_USER=admin
#BREEZONE_ADMIN_PASSWORD=change-me-please
# Session lifetimes: access token (seconds) and sliding device session (days).
BREEZONE_ACCESS_TOKEN_TTL_SECS=900
BREEZONE_REFRESH_TOKEN_TTL_DAYS=365

# ── Remote access (profile "tunnel") ──────────────────────────────────────────────────────
# Token of a Cloudflare Tunnel whose public hostname points to http://breezone:8427
CLOUDFLARE_TUNNEL_TOKEN=

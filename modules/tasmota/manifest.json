{
  "id": "tasmota",
  "version": "1.0.0",
  "name": {"fr": "Tasmota", "en": "Tasmota", "es": "Tasmota"},
  "roles": ["driver"],
  "requires": {"api": "^1.0"},
  "provides": {"traits": ["switch.relay@1.0", "light@1.0", "energy.power@1.0", "energy.meter@1.0", "environment.sensor@1.0"]},
  "models": ["Sonoff (Tasmota)", "Tasmota"],
  "config": [
    {"name": "host", "type": "string", "label": {"fr": "Adresse IP ou nom", "en": "IP address or name", "es": "Dirección IP o nombre"}},
    {"name": "password", "type": "password", "optional": true, "label": {"fr": "Mot de passe de l'interface web (s'il y en a un)", "en": "Web interface password (if any)", "es": "Contraseña de la interfaz web (si la hay)"}}
  ],
  "discovery": {"tcp": [80], "http": [{"port": 80, "path": "/cm?cmnd=Status%200", "contains": "tasmota"}]},
  "permissions": {"network": {"lan": true}, "memory_mb": 16},
  "read_every_s": 10,
  "optional_calls": ["probe", "diagnostic"]
}

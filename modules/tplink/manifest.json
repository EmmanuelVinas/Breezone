{
  "id": "tplink",
  "version": "1.1.0",
  "name": {"en": "TP-Link Kasa · Tapo", "es": "TP-Link Kasa · Tapo", "fr": "TP-Link Kasa · Tapo"},
  "roles": ["driver"],
  "requires": {"api": "^1.1"},
  "provides": {"traits": ["switch.relay@1.0", "light@1.0", "energy.power@1.0"]},
  "models": ["Tapo P100, P110, P115, L510, L530…", "Kasa HS100, HS110, KP115, HS300, KL130…"],
  "config": [
    {"name": "host", "type": "string", "label": {"en": "IP address or name", "es": "Dirección IP o nombre", "fr": "Adresse IP ou nom"}},
    {"name": "username", "type": "string", "optional": true, "label": {"en": "TP-Link account e-mail (Tapo)", "es": "Correo de la cuenta TP-Link (Tapo)", "fr": "E-mail du compte TP-Link (Tapo)"}},
    {"name": "password", "type": "password", "optional": true, "label": {"en": "TP-Link account password (Tapo)", "es": "Contraseña de la cuenta TP-Link (Tapo)", "fr": "Mot de passe du compte TP-Link (Tapo)"}}
  ],
  "discovery": {"tcp": [9999]},
  "permissions": {"network": {"lan": true}},
  "read_every_s": 10,
  "optional_calls": ["identify", "probe", "diagnostic"]
}

{
  "id": "hoymiles",
  "version": "1.0.0",
  "name": {
    "en": "Hoymiles (DTU Wi-Fi)",
    "es": "Hoymiles (DTU Wi-Fi)",
    "fr": "Hoymiles (DTU Wi-Fi)"
  },
  "roles": [
    "driver"
  ],
  "requires": {
    "api": "^1.0"
  },
  "provides": {
    "traits": [
      "energy.power@1.0",
      "solar.inverter@1.0",
      "solar.panel@1.0"
    ]
  },
  "models": [
    "DTU-W100/DTU-Lite-S",
    "DTU-WLite",
    "DTU-Pro",
    "HM, HMS, HMT"
  ],
  "config": [
    {
      "name": "host",
      "type": "string",
      "label": {
        "en": "IP address or name",
        "es": "Dirección IP o nombre",
        "fr": "Adresse IP ou nom"
      }
    }
  ],
  "discovery": {
    "tcp": [
      10081
    ]
  },
  "permissions": {
    "network": {
      "lan": true
    }
  },
  "read_every_s": 30,
  "optional_calls": [
    "probe",
    "diagnostic"
  ]
}

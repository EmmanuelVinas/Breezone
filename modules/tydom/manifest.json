{
  "id": "tydom",
  "version": "1.0.0",
  "name": {
    "en": "Delta Dore Tydom",
    "es": "Delta Dore Tydom",
    "fr": "Delta Dore Tydom"
  },
  "roles": [
    "driver"
  ],
  "requires": {
    "api": "^1.3"
  },
  "provides": {
    "traits": [
      "cover.position@1.0",
      "light@1.0"
    ]
  },
  "models": [
    "Tydom 1.0",
    "Tydom Home, Tydom 2.0"
  ],
  "config": [
    {
      "name": "host",
      "type": "string",
      "label": {
        "en": "IP address of the gateway",
        "es": "Dirección IP de la pasarela",
        "fr": "Adresse IP de la passerelle"
      }
    },
    {
      "name": "mac",
      "type": "string",
      "label": {
        "en": "MAC address of the gateway (on its label: 001A25…)",
        "es": "Dirección MAC de la pasarela (en su etiqueta: 001A25…)",
        "fr": "Adresse MAC de la passerelle (sur son étiquette : 001A25…)"
      }
    },
    {
      "name": "password",
      "type": "password",
      "label": {
        "en": "Password of the gateway",
        "es": "Contraseña de la pasarela",
        "fr": "Mot de passe de la passerelle"
      }
    }
  ],
  "permissions": {
    "network": {
      "lan": true
    }
  },
  "read_every_s": 30,
  "optional_calls": [
    "diagnostic"
  ]
}

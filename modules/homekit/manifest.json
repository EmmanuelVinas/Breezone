{
  "id": "homekit",
  "version": "1.0.0",
  "name": {
    "en": "HomeKit (Legrand, VELUX…)",
    "es": "HomeKit (Legrand, VELUX…)",
    "fr": "HomeKit (Legrand, VELUX…)"
  },
  "roles": [
    "driver"
  ],
  "requires": {
    "api": "^1.0"
  },
  "provides": {
    "traits": [
      "cover.position@1.0",
      "switch.relay@1.0",
      "button@1.0"
    ]
  },
  "models": [
    "Legrand Home + Control",
    "VELUX App Control (KIG 300)"
  ],
  "pairing": "code",
  "discovery": {
    "mdns": [
      {
        "service": "_hap._tcp"
      }
    ]
  },
  "permissions": {
    "network": {
      "lan": true,
      "mdns": [
        "_hap._tcp"
      ]
    }
  },
  "read_every_s": 10,
  "optional_calls": [
    "listen",
    "diagnostic",
    "forget"
  ]
}

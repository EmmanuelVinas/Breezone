{
  "id": "anker",
  "version": "1.0.1",
  "name": {
    "en": "Anker SOLIX (Modbus TCP)",
    "es": "Anker SOLIX (Modbus TCP)",
    "fr": "Anker SOLIX (Modbus TCP)"
  },
  "roles": [
    "driver"
  ],
  "requires": {
    "api": "^1.1"
  },
  "provides": {
    "traits": [
      "switch.relay@1.0",
      "energy.power@1.0",
      "energy.meter@1.0"
    ]
  },
  "models": [
    "Anker SOLIX Smart Plug Gen 2",
    "Anker SOLIX Smart Meter Gen 2"
  ],
  "config": [
    {
      "name": "host",
      "type": "string",
      "label": {
        "en": "IP address or name",
        "es": "Dirección IP o nombre",
        "fr": "Adresse IP ou nom"
      }
    }
  ],
  "discovery": {
    "tcp": [
      502
    ]
  },
  "permissions": {
    "network": {
      "lan": true
    }
  },
  "read_every_s": 10,
  "optional_calls": [
    "identify",
    "probe",
    "diagnostic"
  ]
}
